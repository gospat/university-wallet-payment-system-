# API Server — Environment Variable Template
# Copy this file to `.env` and populate with real values.
# NEVER commit `.env` to source control.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (MySQL)
#
# IMPORTANT: If `DB_PASSWORD` contains special characters (@ : / % ? [space]),
# they MUST be percent-encoded in the `DATABASE_URL` below:
#   @ → %40    : → %3A    / → %2F    % → %25    ? → %3F    (space) → %20
# On macOS with Homebrew MySQL, prefer the unix socket (`?socket=`) to skip
# IPv6 localhost resolution hangs in Prisma's Rust query engine.
# -----------------------------------------------------------------------------
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change-me
DB_NAME=university_wallet

# Option A — TCP + IPv4 (prefer on Linux / Docker)
# DATABASE_URL="mysql://${DB_USERNAME}:PERCENT_ENCODED_PASSWORD@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Option B — Unix socket (prefer on macOS with Homebrew MySQL)
DATABASE_URL="mysql://${DB_USERNAME}:PERCENT_ENCODED_PASSWORD@localhost/${DB_NAME}?socket=/tmp/mysql.sock"

# -----------------------------------------------------------------------------
# Redis (optional; used for BullMQ webhook queue + rate-limit storage)
# If Redis is unavailable, the platform gracefully degrades to synchronous
# webhook processing (see TR-4.3 in the spec).
# -----------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# Generate with:  openssl rand -hex 64
JWT_SECRET="replace-with-64-char-cryptographically-random-string"
JWT_EXPIRES_IN="24h"

# Generate with:  openssl rand -hex 32
ENCRYPTION_KEY="replace-with-32-char-hex-encryption-key"

# Account lockout (see services/auth.ts defaults)
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LOGIN=20
RATE_LIMIT_MAX_GENERAL=300

# -----------------------------------------------------------------------------
# UNIVERSITY IDENTITY / BRANDING
# All values are OPTIONAL — safe in-code fallbacks are in utils/branding.ts.
# Admin UI "System Settings" saves values to the DB row, and the DB value
# TAKES PRIORITY over the env var listed here (env vars = bulk override layer).
# Logo / Favicon / Signature URLs MUST be https:// publicly reachable URLs.
# -----------------------------------------------------------------------------
# UNIVERSITY_NAME="University Payment Platform"
# UNIVERSITY_LOGO_URL=""
# UNIVERSITY_FAVICON_URL=""
# UNIVERSITY_ADDRESS=""
# UNIVERSITY_PHONE=""
# UNIVERSITY_EMAIL=""
# UNIVERSITY_WEBSITE=""
# UNIVERSITY_BANK_NAME=""
# UNIVERSITY_BANK_ACCOUNT=""
#
# --- BURSARY RECEIPT PRINTED SIGNATURE (all optional): ---
#   If ANY of the three are set the PDF receipt will render:
#     - left column: signature line + optional image + signatory name + title
#     - right column: "APPROVED BY" manual sign + date + stamp/seal box
#   Footer T&C language also flips from "requires no signature" → "validates
#   the Bursary Department signatory above".
# RECEIPT_BURSAR_NAME=""
# RECEIPT_BURSAR_TITLE=""
# RECEIPT_BURSAR_SIGNATURE_URL=""
#
# Existing receipt/payment prefix overrides (in-code defaults = REC / PAY):
# RECEIPT_PREFIX="REC"
# PAYMENT_REF_PREFIX="PAY"
# RECEIPT_FOOTER_TEXT=""

# -----------------------------------------------------------------------------
# Paystack Payment Gateway
# Get these from: https://dashboard.paystack.com/#/settings/developer
# The SECRET key must never leave the backend.
# The PUBLIC key can be shared with the frontend for inline checkouts.
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY="sk_test_replace_me"
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
# For webhook HMAC-SHA512 validation. If left blank, PAYSTACK_SECRET_KEY is used.
PAYSTACK_WEBHOOK_SECRET=""
# Callback URL after a user pays on Paystack (frontend). Defaults to FRONTEND_BASE_URL/student/dashboard
PAYSTACK_CALLBACK_URL=""
# Comma-separated payment channels to enable with Paystack.
# Allowed values: card, bank, ussd, qr, bank_transfer, eft, mobile_money.
# Leave blank to accept all channels enabled in the account currency.
PAYSTACK_ENABLED_CHANNELS="card,bank,ussd,qr,bank_transfer"

# -----------------------------------------------------------------------------
# ALAT Pay (WEMA Bank) Payment Gateway
# Get these from: https://business.alat.ng/dashboard  → Settings → Business → View
# How to obtain keys: enter your ALATPay PIN → reveals Public Key / Secret Key / Business ID / Webhook Secret.
# Only ONE gateway (Paystack OR ALAT Pay) can be ACTIVE at a time — toggle in Admin UI:
#   Admin → System Settings → Active Payment Gateway.
# PENDING transactions from the old gateway will still verify correctly even after you switch.
#
# NAMING CONVENTION (matches working Laravel prod bells-university ProductionCheck L76-L79):
#   SIMPLE/LEGACY: WEMA_ALATPAY_PUBLIC_KEY, WEMA_ALATPAY_SECRET_KEY, WEMA_ALATPAY_BUSINESS_ID,
#                  WEMA_ALATPAY_MERCHANT_ID, WEMA_ALATPAY_WEBHOOK_SECRET, WEMA_ALATPAY_BASE_URL
#   ALATPAY_ prefixed are ACCEPTED as ALIASES (both work). If both are set, WEMA_ wins.
#
# PREFER THE SIMPLE KEY NAME:
#   ALATPAY_SECRET_KEY (single-key production pattern) → resolved first before SANDBOX/PROD splits
# -----------------------------------------------------------------------------
# sandbox = test transactions. prod = real money charges. If unset, sandbox-mode is assumed for test key selection.
ALATPAY_MODE=sandbox
# Base URL — sandbox default = https://apibox.alatpay.ng. Override explicitly here if different.
ALATPAY_BASE_URL="https://apibox.alatpay.ng"
# SIMPLE SINGLE-KEY (preferred — matches WEMA_ALATPAY_SECRET_KEY from working production code):
ALATPAY_SECRET_KEY=""
# Optional split-key legacy naming (ONLY use if ALATPAY_SECRET_KEY is unset):
ALATPAY_SANDBOX_SECRET_KEY=""
ALATPAY_PROD_SECRET_KEY=""
# Public Key — frontend web-plugin usage (optional — server-init redirect flow does NOT need public key)
ALATPAY_PUBLIC_KEY=""
# Business ID (UUID from dashboard Settings → Business → View → UUID / Business ID)
ALATPAY_BUSINESS_ID=""
# Merchant ID (REQUIRED SEPARATE identifier per working bells-university production
#   config/services.php merchant_id field — do NOT reuse Business ID UUID.
#   Get this from working bells-university .env value WEMA_ALATPAY_MERCHANT_ID or dashboard)
ALATPAY_MERCHANT_ID=""
# Webhook secret — header "x-alatpay-signature" or "alatpay-signature" = Base64(HMAC-SHA256(raw_body, WEBHOOK_SECRET))
# NOTE: Per working production AlatpayService.php L296: HMAC checks are WARN-only, never 403-reject (ALATPAY sometimes sends broken signatures)
ALATPAY_WEBHOOK_SECRET=""
# --- ALATPAY SANDBOX/SERVER-SIDE TUNING OPTIONAL OVERRIDES (all have safe in-code defaults): ---
# PaymentLinkCurrency enum ordinal for Nigerian Naira (NGN) — in-code default=2 (empirically verified).
# Do NOT change unless ALATPAY updates their internal enum (probe values 0/1/2/3 to re-verify).
# ALATPAY_CURRENCY_ORDINAL_NGN=2
# Pass payment charges through to customer (alters ALATPAY initialize passCharge body field). Default=false.
# ALATPAY_PASS_CHARGE_TO_CUSTOMER=false
# Comma-separated ALATPAY outgoing webhook IPs. Default: 74.178.162.156. Add new IPs if ALATPAY expands.
# ALATPAY_WEBHOOK_WHITELIST_IPS="74.178.162.156"
# Fallback email domain used when a payment is initiated without an explicit customer email.
# DEFAULT_EMAIL_FALLBACK_DOMAIN="university.edu.ng"
# ALATPAY channel-code overrides (all default to documented ALATPAY official codes — only change if provider reassigns):
# ALATPAY_CHANNEL_CARD=1
# ALATPAY_CHANNEL_BANK=2
# ALATPAY_CHANNEL_BANK_TRANSFER=2
# ALATPAY_CHANNEL_USSD=5
# ALATPAY_CHANNEL_BANK_DETAILS=3
# ALATPAY_CHANNEL_STATIC=8
# WEMA_ALATPAY_* aliases — paste these directly from the bells-university server .env if migrating (all are loaded as fallbacks):
# WEMA_ALATPAY_SECRET_KEY=""
# WEMA_ALATPAY_PUBLIC_KEY=""
# WEMA_ALATPAY_BUSINESS_ID=""
# WEMA_ALATPAY_MERCHANT_ID=""
# WEMA_ALATPAY_WEBHOOK_SECRET=""
# WEMA_ALATPAY_BASE_URL=""
# -----------------------------------------------------------------------------
# SANDBOX TEST CARDS (ALATPAY_MODE=sandbox):
#   Success: 4111111111111111 (Visa) / 5555555555554444 (MC) / 506104000000000058 (Verve)
#   CVV: 123  Expiry: 12/30  PIN: 1234  OTP: 123456
#   Insufficient Funds: 4000000000000002
#   Suspected Fraud:    5555555555554519
# WEBHOOK SETUP:
#   Paystack callback URL:  {APP_BASE_URL}/api/v1/webhooks/paystack
#   ALAT Pay webhook:   {APP_BASE_URL}/api/v1/webhooks/alatpay
#   ALAT Pay outgoing IP whitelist: 74.178.162.156 (optional; default WARN-ONLY log)

# -----------------------------------------------------------------------------
# Payment service-charges & fees (applied on TOP of the invoice amount).
# Set to 0 to disable (default).
# NOTE: For Nigerian university use a %2 of the amount, plus a flat NGN fee.
# - PAYSTACK_SERVICE_CHARGE_FLAT="0.00"
PAYSTACK_SERVICE_CHARGE_PERCENT="0.00"
# Estimated Paystack gateway fee (d on the invoice amount) recorded as an expense.
# Does not change the amount charged to the student — only affects the UNIVERSITY_EXPENSES_FEE ledger classification for reporting.
PAYSTACK_GATEWAY_FEE_PERCENT="0.00"

# Base URL used in: receipt verification links, email deep links, Paystack callback, ALAT Pay webhookUrl field
#  → PORT 3001 = current running API; PORT 5174 = current running Vite (NOT 5173)
#  → For internet-reachable setups (ngrok / live server), replace localhost URLs with HTTPS ngrok/domain URLs
APP_BASE_URL="http://localhost:3001"
FRONTEND_BASE_URL="http://localhost:5174"
# Optional NGROK override (HIGHLY RECOMMENDED for ALATPAY/WEMA during testing):
# APP_BASE_URL="https://<your-ngrok-id>.ngrok-free.app"
# FRONTEND_BASE_URL="https://<your-ngrok-id>.ngrok-free.app"

# -----------------------------------------------------------------------------
# Email / SMTP (for password resets, receipts, refund notifications)
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="no-reply@university.edu.ng"
SMTP_PASS="change-me"
EMAIL_FROM_NAME="University Bursary"
EMAIL_FROM_ADDRESS="no-reply@university.edu.ng"
EMAIL_REPLY_TO_ADDRESS="bursary@university.edu.ng"

# -----------------------------------------------------------------------------
# University Branding (receipts, emails, PDFs)
# -----------------------------------------------------------------------------
UNIVERSITY_NAME="University Payment Platform"
UNIVERSITY_ADDRESS="123 Academic Way, Campus City"
UNIVERSITY_PHONE="+234 000 000 0000"
UNIVERSITY_WEBSITE="https://www.university.edu.ng"
UNIVERSITY_LOGO_URL=""
UNIVERSITY_BANK_NAME=""
UNIVERSITY_BANK_ACCOUNT=""
