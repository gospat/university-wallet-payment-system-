# API Server — Environment Variable Template
# Copy this file to `.env` and populate with real values.
# NEVER commit `.env` to source control.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Number of trusted reverse-proxy hops between the client and this Node app.
# Default 1 = single nginx in front (our production setup).
# If Bells IT ever puts Cloudflare/AWS ALB in front of nginx, increase to 2 or 3.
# Affects: rate limit client IP, audit log ipAddress, req.secure TLS check.
TRUST_PROXY_HOPS=1

# Bearer token protecting /api/v1/metrics (Prometheus / Grafana scrape endpoint).
# If blank, metrics endpoint returns 401. Use:  openssl rand -hex 32
METRICS_TOKEN=

# -----------------------------------------------------------------------------
# Database (MySQL 8.0 — Prisma provider = mysql)
#
# IMPORTANT: If `DB_PASSWORD` contains special characters (@ : / % ? [space]),
# they MUST be percent-encoded in the `DATABASE_URL` below:
#   @ → %40    : → %3A    / → %2F    % → %25    ? → %3F    (space) → %20
# -----------------------------------------------------------------------------
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=bells_payment_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_NAME=bells_payment_db

# Production DSN — copy-paste into production api/.env after replacing passwords:
# DATABASE_URL="mysql://${DB_USERNAME}:PERCENT_ENCODED_PASSWORD@${DB_HOST}:${DB_PORT}/${DB_NAME}?socket=/var/run/mysqld/mysqld.sock"
#
# macOS Homebrew local dev (socket path differs):
DATABASE_URL="mysql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# -----------------------------------------------------------------------------
# Redis (required; used for BullMQ email queue + rate-limit storage)
# -----------------------------------------------------------------------------
REDIS_URL="redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:6379/0"

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# Generate JWT_SECRET + JWT_REFRESH_SECRET with:  openssl rand -hex 64
# BOTH ARE REQUIRED — JWT_REFRESH_SECRET must be independent of JWT_SECRET.
# The server will REFUSE TO START if JWT_REFRESH_SECRET is blank or not set.
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX_STRING_FROM_OPENSSL_RAND_HEX_64"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_CHAR_HEX_STRING__REQUIRED__DO_NOT_LEAVE_BLANK"
JWT_EXPIRES_IN="15m"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Generate 32-byte AES encryption key for PII columns in DB:
#   openssl rand -hex 32
ENCRYPTION_KEY="REPLACE_WITH_64_CHAR_HEX_KEY"

# Account lockout (services/auth.ts defaults)
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Bcrypt work factor — 12 takes ~250ms/hash on modern VPS. Do NOT lower below 10.
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# PRODUCTION PUBLIC URLS (CRITICAL — SET THESE BEFORE FIRST DEPLOY!)
#
#   FRONTEND_BASE_URL  = Students + Admin React portal URL (payment.bellsuniversity...)
#   APP_BASE_URL       = Backend API URL (paymentapi.bellsuniversity...)
#   PUBLIC_URL         = Canonical frontend URL, used in QR codes, email branding
#   CORS_ORIGIN        = CSV list of origins allowed to call the API
# -----------------------------------------------------------------------------
APP_BASE_URL="https://paymentapi.bellsuniversity.edu.ng"
PUBLIC_URL="https://payment.bellsuniversity.edu.ng"
PUBLIC_API_URL="https://paymentapi.bellsuniversity.edu.ng/api/v1"
FRONTEND_BASE_URL="https://payment.bellsuniversity.edu.ng"

# CSV list of allowed browser origins (payment.bellsuniversity is always allowed via
# the CORS_ORIGIN fallback in app.ts — put any additional origins here if needed):
#   Example:  CORS_ORIGIN="https://payment.bellsuniversity.edu.ng,https://admin.bellsuniversity.edu.ng,http://localhost:5173"
CORS_ORIGIN="https://payment.bellsuniversity.edu.ng"

# Where password-welcome emails link when they say "Go to the Student Portal":
STUDENT_PORTAL_URL="https://payment.bellsuniversity.edu.ng/login"

# -----------------------------------------------------------------------------
# UNIVERSITY IDENTITY / BRANDING
# All values are OPTIONAL — safe in-code fallbacks are in utils/branding.ts.
# Admin UI "System Settings" saves values to the DB row, and the DB value
# TAKES PRIORITY over the env var listed here (env vars = bulk override layer).
# Logo / Favicon / Signature URLs MUST be https:// publicly reachable URLs.
# -----------------------------------------------------------------------------
# UNIVERSITY_NAME="Bells University of Technology"
# UNIVERSITY_LOGO_URL=""
# UNIVERSITY_FAVICON_URL=""
# UNIVERSITY_ADDRESS="Km 8, Idiroko Road, Ota, Ogun State, Nigeria"
# UNIVERSITY_PHONE="+234 700 000 0000"
# UNIVERSITY_EMAIL="bursary@bellsuniversity.edu.ng"
# UNIVERSITY_WEBSITE="https://www.bellsuniversity.edu.ng"
# UNIVERSITY_BANK_NAME=""
# UNIVERSITY_BANK_ACCOUNT=""
#
# --- BURSARY RECEIPT PRINTED SIGNATURE (all optional): ---
#   If ANY of the three are set the PDF receipt will render:
#     - left column: signature line + optional image + signatory name + title
#     - right column: "APPROVED BY" manual sign + date + stamp/seal box
# RECEIPT_BURSAR_NAME=""
# RECEIPT_BURSAR_TITLE=""
# RECEIPT_BURSAR_SIGNATURE_URL=""
#
# Receipt/payment prefix overrides (in-code defaults = REC / PAY):
# RECEIPT_PREFIX="REC"
# PAYMENT_REF_PREFIX="PAY"
# RECEIPT_FOOTER_TEXT=""

# -----------------------------------------------------------------------------
# Paystack Payment Gateway
# Get these from: https://dashboard.paystack.com/#/settings/developer
# The SECRET key must never leave the backend.
# The PUBLIC key can be shared with the frontend for inline checkouts.
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY="sk_prod_REPLACE_ME"
PAYSTACK_PUBLIC_KEY="pk_prod_REPLACE_ME"
# For webhook HMAC-SHA512 validation. If left blank, PAYSTACK_SECRET_KEY is used.
PAYSTACK_WEBHOOK_SECRET="REPLACE_FROM_PAYSTACK_DASHBOARD"
# Callback URL after a user pays on Paystack (frontend). Defaults to FRONTEND_BASE_URL/student/dashboard
PAYSTACK_CALLBACK_URL="https://payment.bellsuniversity.edu.ng/student/dashboard"
# Comma-separated payment channels to enable with Paystack.
# Allowed values: card, bank, ussd, qr, bank_transfer, eft, mobile_money.
PAYSTACK_ENABLED_CHANNELS="card,bank,ussd,qr,bank_transfer"

# -----------------------------------------------------------------------------
# ALAT Pay (WEMA Bank) Payment Gateway
# Get these from: https://business.alat.ng/dashboard  → Settings → Business → View
# How to obtain keys: enter your ALATPay PIN → reveals Public Key / Secret Key / Business ID / Webhook Secret.
# Only ONE gateway (Paystack OR ALAT Pay) can be ACTIVE at a time — toggle in Admin UI:
#   Admin → System Settings → Active Payment Gateway.
#
# NAMING CONVENTION (matches working Laravel prod bells-university ProductionCheck L76-L79):
#   SIMPLE/LEGACY: WEMA_ALATPAY_PUBLIC_KEY, WEMA_ALATPAY_SECRET_KEY, WEMA_ALATPAY_BUSINESS_ID,
#                  WEMA_ALATPAY_MERCHANT_ID, WEMA_ALATPAY_WEBHOOK_SECRET, WEMA_ALATPAY_BASE_URL
#   ALATPAY_ prefixed are ACCEPTED as ALIASES (both work). If both are set, WEMA_ wins.
#
# PREFER THE SIMPLE KEY NAME:
#   ALATPAY_SECRET_KEY (single-key production pattern) → resolved first before SANDBOX/PROD splits
# -----------------------------------------------------------------------------
ALATPAY_MODE=prod
ALATPAY_BASE_URL="https://api.alatpay.ng"
ALATPAY_SECRET_KEY="REPLACE_FROM_ALATPAY_DASHBOARD"
ALATPAY_PUBLIC_KEY=""
ALATPAY_BUSINESS_ID=""
ALATPAY_MERCHANT_ID=""
ALATPAY_WEBHOOK_SECRET="REPLACE_FROM_ALATPAY_DASHBOARD"
# --- SANDBOX legacy keys only if ALATPAY_SECRET_KEY is left blank ---
# ALATPAY_SANDBOX_SECRET_KEY=""
# ALATPAY_PROD_SECRET_KEY=""

# --- ALATPAY TUNING (all have safe in-code defaults): ---
# Currency enum ordinal 2 = Nigerian Naira (empirically verified on sandbox+prod)
# ALATPAY_CURRENCY_ORDINAL_NGN=2
# Pass charges through to student? true = student pays service fee + bank charges
# ALATPAY_PASS_CHARGE_TO_CUSTOMER=false
# Outgoing webhook source IPs (warn-only log if mismatch):
# ALATPAY_WEBHOOK_WHITELIST_IPS="74.178.162.156"
# Fallback email domain when a payment-initiation request comes without a student email:
# DEFAULT_EMAIL_FALLBACK_DOMAIN="bellsuniversity.edu.ng"

# --- WEBHOOK URLs to set on provider dashboards ---
#   Paystack:  https://paymentapi.bellsuniversity.edu.ng/api/v1/webhooks/paystack
#   ALAT Pay:  https://paymentapi.bellsuniversity.edu.ng/api/v1/webhooks/alatpay

# --- ALATPAY OFFICIAL NATIVE MODAL / POPUP CHECKOUT (Optional) ---
#   When false or unset: legacy hosted Payment-Link redirect/paylink.alatpay.ng iframe flow.
#   When true:      Bells backend resolves the merchant identity server-side using the existing
#                   ALATPAY_SECRET_KEY (never exposed to browser), returns a MINIMAL 4-field
#                   sanitized business identity (id/businessId/name/logoUrl ONLY) to frontend,
#                   frontend loads ALATPay's official SDK ON DEMAND and launches ALATPay's
#                   official checkout popup/modal directly in the student's browser.
#                   ALATPay itself shows Card / Bank Transfer / USSD / Bank channels decided by
#                   the merchant profile. NO custom Bells payment-method UI is rendered.
#                   Browser popup onTransaction callback NEVER marks a payment successful —
#                   the backend webhook + server verify path remain 100% authoritative.
#   If the native-modal mode fails backend preparation (sanitization abort, network issues,
#   unexpected credential fields in provider response), the HTTP request returns a 502 with
#   code ALATPAY_POPUP_UNAVAILABLE and NO checkout URL. The student may retry or select Paystack.
#   There is NO automatic fallback to the legacy payment-link experience while this flag is true.
#
#   Production deployment instructions: feature is enabled in production via the systemd
#   service's environment mechanism (EnvironmentFile= or Environment= lines). The default
#   unset/false keeps the legacy hosted payment-link path active as the baseline execution.
#   Enabling in production is a separate deployment-phase decision that requires explicit approval.
#
# ALATPAY_USE_POPUP_CHECKOUT=false

# -----------------------------------------------------------------------------
# Payment service-charges & fees (applied on TOP of the invoice amount).
# Set to 0 to disable (default).
# Nigerian universities typically charge 0.00 (absorb fees) or 2.00% with a ₦100 cap per NDPR/FEC guidelines.
# -----------------------------------------------------------------------------
PAYSTACK_SERVICE_CHARGE_FLAT="0.00"
PAYSTACK_SERVICE_CHARGE_PERCENT="0.00"
PAYSTACK_GATEWAY_FEE_PERCENT="0.00"

# -----------------------------------------------------------------------------
# Email / SMTP / Resend (for password resets, receipts, credentials, refund notifications)
#
# Priority cascade (configurable via Admin DB SystemSettings.emailProviderForceSmtp=true):
#   (1) If RESEND_API_KEY is set below  → use Resend (Africa-friendly, fast, modern API)
#   (2) Else if ALL SMTP_* are configured → use nodemailer SMTP
#   (3) Else                               → Mock JSON transport (dev only, written to sentCaptures[])
#
# Admin DB EmailTemplateConfig table overrides sender name/address, subject,
# portal URL, greeting/paragraph/button/closing text via the admin UI.
# -----------------------------------------------------------------------------
# --- RESEND (preferred — signup at https://resend.com) ---
# Verify your sending domain first: https://resend.com/domains → copy DNS records
# Then create an API key: https://resend.com/api-keys → paste below:
RESEND_API_KEY=re_prod_REPLACE_ME

# --- SMTP (fallback, used when Resend API key is blank) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="bursary@bellsuniversity.edu.ng"
SMTP_PASS="REPLACE_WITH_APP_PASSWORD_NOT_GMAIL_PASSWORD"

# --- ENV-level sender identity overrides (fallback: DB EmailTemplateConfig > env > compile-time) ---
EMAIL_FROM_NAME="Bells University Bursary"
EMAIL_FROM_ADDRESS="bursary@bellsuniversity.edu.ng"
EMAIL_REPLY_TO_ADDRESS="bursary@bellsuniversity.edu.ng"
BURSARY_EMAIL="bursary@bellsuniversity.edu.ng"
FINANCE_EMAIL="finance@bellsuniversity.edu.ng"

# -----------------------------------------------------------------------------
# University Branding (receipts, emails, PDFs)  — optional; DB settings override
# -----------------------------------------------------------------------------
UNIVERSITY_NAME="Bells University of Technology"
UNIVERSITY_ADDRESS="Km 8, Idiroko Road, Ota, Ogun State, Nigeria"
UNIVERSITY_PHONE="+234 700 000 0000"
UNIVERSITY_WEBSITE="https://www.bellsuniversity.edu.ng"
UNIVERSITY_EMAIL="bursary@bellsuniversity.edu.ng"
UNIVERSITY_LOGO_URL="https://payment.bellsuniversity.edu.ng/branding/logo.png"
UNIVERSITY_BANK_NAME=""
UNIVERSITY_BANK_ACCOUNT=""
