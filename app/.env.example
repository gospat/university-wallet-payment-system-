# Frontend App — Environment Variable Template
# Copy this file to `.env.local` (preferred) or `.env` and populate.
# Vite env vars MUST be prefixed with `VITE_` to be exposed to the browser.

# Base URL of the running API server (without trailing slash).
# For local dev: API started on :3001 (NOT :3000; must match backend PORT env).
# For staging/prod: point to the deployed API domain
VITE_API_URL="http://localhost:3001/api/v1"

# Public-only keys below — NEVER put secret keys here.
VITE_PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
# ALAT Pay public key + Business ID (optional — server-init redirect flow does NOT need these.
# Included only if you later switch to the browser popup SDK. NEVER put SECRET key or WEBHOOK SECRET here.
VITE_ALATPAY_PUBLIC_KEY=""
VITE_ALATPAY_BUSINESS_ID=""

# University branding
# NOTE: Runtime branding values (name, logo, favicon, bank details, bursar
# signature etc.) are now LOADED AT RUNTIME from the backend unauthenticated
# endpoint /api/v1/public/branding. There is no need to duplicate them here as
# VITE_* vars — Admin edits in System Settings propagate live without a
# frontend rebuild or redeploy.
#
# VITE_UNIVERSITY_NAME and VITE_UNIVERSITY_WEBSITE below are kept only as
# fallback offline boot-time values; the server values always win.
VITE_UNIVERSITY_NAME="University Payment Platform"
VITE_UNIVERSITY_WEBSITE="https://www.university.edu.ng"
