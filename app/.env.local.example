# Vite frontend build — environment variable template
#
# HOW TO USE:
#   1. Copy this file EXACTLY and name the copy ".env.local" (NO template suffix).
#      Example:  cp .env.local.example .env.local
#   2. Replace the placeholder value below with the REAL backend URL you want the
#      React app to make AJAX calls to.
#   3. REBUILD the React app:  npm run build
#
# ⚠️  CRITICAL: Vite reads env vars AT BUILD TIME and BAKES them into the static JS.
#     Changing this file AFTER you run `npm run build` does nothing — you must rebuild!
#
# ⚠️  ⚠️  DO NOT put secrets (API keys, passwords, Redis passwords) here — .env.local
#            values are shipped to the BROWSER and visible to anyone inspecting the page.
#

# Local dev: Vite dev server at http://localhost:5173 → API on http://localhost:3001
# (This matches the default fallback hardcoded in src/services/api.ts.)
# VITE_API_BASE_URL=http://localhost:3001/api/v1

# Production Ubuntu VPS: frontend = https://payment.bellsuniversity.edu.ng
#                        backend  = https://paymentapi.bellsuniversity.edu.ng/api/v1
VITE_API_BASE_URL=https://paymentapi.bellsuniversity.edu.ng/api/v1

# VITE_ALATPAY_ENV: (optional) "sandbox" or "production".
#   Controls which official ALATPay checkout JS SDK script is loaded dynamically:
#     sandbox    = https://alatpay-client.azurewebsites.net/js/alatpay.js
#     production = https://web.alatpay.ng/js/alatpay.js
#   If unset, default heuristic: window.location.protocol === "https:" => production; else sandbox.
#   UNUSED unless backend ALATPAY_USE_POPUP_CHECKOUT=true; kept for future frontend-
#   switching capability during a future deployment phase.
# VITE_ALATPAY_ENV="sandbox"
