# Core
NODE_ENV=development
JWT_SECRET=replace-with-strong-random-secret
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800

# Services
PORT_API=3001
PORT_APP=3000
DATABASE_URL=mysql://root:rootpassword@127.0.0.1:3306/university_payment_gateway
REDIS_URL=redis://127.0.0.1:6379

# SMTP (optional; mock JSON transport used when SMTP_HOST is blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="University Bursary <noreply@university.example>"
SMTP_RATE_PER_MIN=120

# Session / Academic
CURRENT_SESSION=2025/2026

# Toggles
CRON_CLEANUP_ENABLED=true
